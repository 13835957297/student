{
  "name": "aigc-student",
  "version": "1.0.0",
  "description": "AIGC应用--学生",
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "build": {
    "appId": "com.yourcompany.yourapp",
    "productName": "AIGC App",
    "directories": {
      "output": "aigc_student_dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "amd64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "./assets/icon.png"
    }
  },
  "keywords": [
    "Electron"
  ],
  "author": "liuanwen",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.9.0",
    "@electron-forge/maker-deb": "^7.9.0",
    "@electron-forge/maker-rpm": "^7.9.0",
    "@electron-forge/maker-squirrel": "^7.9.0",
    "@electron-forge/maker-zip": "^7.9.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.9.0",
    "@electron-forge/plugin-fuses": "^7.9.0",
    "@electron/fuses": "^1.8.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.0.12",
    "electron-reloader": "^1.2.3",
    "moment": "^2.30.1"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "git-filter-repo": "^0.0.30"
  }
}
